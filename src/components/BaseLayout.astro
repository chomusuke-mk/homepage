---
import ThemeToggle from './ThemeToggle.astro';
import LanguageToggle from './LanguageToggle.astro';
import { useTranslations, useTranslatedPath, type Lang } from '@i18n/utils';
import '@styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
}

const {
  lang = 'es',
  title = lang === 'en'
    ? 'Chomusuke | Software Engineer & Open Source Developer'
    : 'Chomusuke | Desarrollador de Software',
  description = lang === 'en'
    ? 'Software engineering portfolio by Chomusuke. Cross-platform apps, containerized build toolchains, and telemetry-free open-source software.'
    : 'Portafolio de proyectos de software y desarrollo multiplataforma por Chomusuke. Herramientas de automatización, compilación cruzada y distribución de aplicaciones.',
} = Astro.props;

const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const homePath = translatePath('/');
---

<!doctype html>
<html lang={lang} class="h-full scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Chomusuke" />
    <meta name="theme-color" content="#6366f1" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/png" href="/icons/avatar.png" />

    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- FOUC Prevention Script -->
    <script is:inline>
      (function () {
        try {
          const savedTheme = localStorage.getItem('theme');
          const prefersDark = window.matchMedia(
            '(prefers-color-scheme: dark)'
          ).matches;
          if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (error) {
          void error;
          if (
            window.matchMedia &&
            window.matchMedia('(prefers-color-scheme: dark)').matches
          ) {
            document.documentElement.classList.add('dark');
          }
        }
      })();
    </script>

    <!-- Language Redirect Script -->
    <script is:inline define:vars={{ currentLang: lang }}>
      (function () {
        try {
          const savedLang = localStorage.getItem('preferredLang');
          let targetLang = null;
          if (savedLang) {
            if (savedLang !== currentLang) {
              targetLang = savedLang;
            }
          } else {
            const browserLang =
              navigator.language || navigator.userLanguage || '';
            const detectedLang = browserLang.toLowerCase().startsWith('en')
              ? 'en'
              : 'es';
            if (detectedLang !== currentLang) {
              targetLang = detectedLang;
            }
          }
          if (targetLang) {
            const currentPath = window.location.pathname;
            let targetPath = currentPath;
            if (targetLang === 'en') {
              targetPath = currentPath === '/' ? '/en' : '/en' + currentPath;
            } else {
              targetPath = currentPath.replace(/^\/en(?=\/|$)/, '') || '/';
            }
            window.location.replace(targetPath + window.location.hash);
          }
        } catch (error) {
          void error;
        }
      })();
    </script>
  </head>
  <body
    class="bg-surface-50 text-surface-900 dark:bg-surface-950 dark:text-surface-100 flex min-h-full flex-col font-sans antialiased transition-colors duration-300"
  >
    <!-- Skip Link for Accessibility -->
    <a
      href="#main-content"
      class="focus:bg-brand-600 focus:ring-brand-500 dark:focus:ring-brand-400 dark:focus:ring-offset-surface-950 sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:px-4 focus:py-2 focus:text-white focus:shadow-lg focus:ring-2 focus:ring-offset-2 focus:outline-none"
    >
      {t('nav.skip')}
    </a>

    <!-- Header -->
    <header
      class="border-surface-200/60 bg-surface-50/80 dark:border-surface-800/60 dark:bg-surface-950/80 sticky top-0 z-40 w-full border-b backdrop-blur-xl"
    >
      <div class="section-container flex h-16 items-center justify-between">
        <div class="flex items-center gap-3">
          <a
            href={homePath}
            class="group text-surface-900 hover:text-brand-600 focus-visible:ring-brand-500 dark:hover:text-brand-400 dark:focus-visible:ring-brand-400 flex items-center gap-2 rounded-lg text-lg font-bold tracking-tight transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 dark:text-white"
            aria-label={lang === 'en'
              ? 'Home - Chomusuke'
              : 'Inicio - Chomusuke'}
          >
            <!-- Logo Icon -->
            <img
              src="/icons/avatar.png"
              alt=""
              class="shadow-brand-500/25 h-8 w-8 rounded-lg object-cover shadow-md transition-transform group-hover:scale-110"
              loading="eager"
              decoding="async"
            />
            <span>Chomusuke</span>
          </a>
        </div>

        <nav aria-label={t('nav.projects')} class="flex items-center gap-2">
          <a
            href="#proyectos"
            class="text-surface-600 hover:bg-surface-100 hover:text-surface-900 focus-visible:ring-brand-500 dark:text-surface-400 dark:hover:bg-surface-800 dark:hover:text-surface-100 hidden rounded-lg px-3 py-2 text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2 sm:inline-flex"
          >
            {t('nav.projects')}
          </a>
          <a
            href="#sobre-mi"
            class="text-surface-600 hover:bg-surface-100 hover:text-surface-900 focus-visible:ring-brand-500 dark:text-surface-400 dark:hover:bg-surface-800 dark:hover:text-surface-100 hidden rounded-lg px-3 py-2 text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2 sm:inline-flex"
          >
            {t('nav.about')}
          </a>
          <a
            href="#instalar"
            class="text-surface-600 hover:bg-surface-100 hover:text-surface-900 focus-visible:ring-brand-500 dark:text-surface-400 dark:hover:bg-surface-800 dark:hover:text-surface-100 hidden rounded-lg px-3 py-2 text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2 sm:inline-flex"
          >
            {t('nav.install')}
          </a>
          <a
            href="https://github.com/chomusuke-mk"
            target="_blank"
            rel="noopener noreferrer"
            class="text-surface-600 hover:bg-surface-100 hover:text-surface-900 focus-visible:ring-brand-500 dark:text-surface-400 dark:hover:bg-surface-800 dark:hover:text-surface-100 inline-flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2"
            aria-label={lang === 'en' ? 'GitHub Profile' : 'Perfil de GitHub'}
          >
            <svg
              class="h-4 w-4"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                clip-rule="evenodd"></path>
            </svg>
            <span class="hidden sm:inline">GitHub</span>
          </a>

          <LanguageToggle currentLang={lang} />
          <ThemeToggle lang={lang} />
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main id="main-content" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>

    <!-- Footer -->
    <footer
      class="border-surface-200/60 bg-surface-100/50 dark:border-surface-800/60 dark:bg-surface-900/50 border-t py-12"
    >
      <div class="section-container">
        <div
          class="flex flex-col items-center gap-6 sm:flex-row sm:justify-between"
        >
          <div class="flex items-center gap-3">
            <img
              src="/icons/avatar.png"
              alt=""
              class="h-8 w-8 rounded-lg object-cover"
              loading="lazy"
              decoding="async"
            />
            <div>
              <p
                class="text-surface-900 dark:text-surface-100 text-sm font-semibold"
              >
                Chomusuke
              </p>
              <p class="text-surface-500 dark:text-surface-400 text-xs">
                {t('footer.role')}
              </p>
            </div>
          </div>

          <div class="flex items-center gap-4">
            <a
              href="https://github.com/chomusuke-mk"
              target="_blank"
              rel="noopener noreferrer"
              class="text-surface-500 hover:bg-surface-200 hover:text-surface-700 focus-visible:ring-brand-500 dark:text-surface-400 dark:hover:bg-surface-800 dark:hover:text-surface-200 rounded-full p-2 transition-colors focus:outline-none focus-visible:ring-2"
              aria-label={lang === 'en'
                ? 'GitHub Chomusuke'
                : 'GitHub de Chomusuke'}
            >
              <svg
                class="h-5 w-5"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                  clip-rule="evenodd"></path>
              </svg>
            </a>
            <a
              href="https://www.buymeacoffee.com/chomusuke"
              target="_blank"
              rel="noopener noreferrer"
              class="text-surface-500 hover:bg-surface-200 hover:text-surface-700 focus-visible:ring-brand-500 dark:text-surface-400 dark:hover:bg-surface-800 dark:hover:text-surface-200 rounded-full p-2 transition-colors focus:outline-none focus-visible:ring-2"
              aria-label={lang === 'en'
                ? 'Buy Me a Coffee'
                : 'Apoyar en Buy Me a Coffee'}
            >
              <svg
                class="h-5 w-5"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  d="M20.216 6.415l-.132-.666c-.119-.598-.388-1.163-1.001-1.379-.197-.069-.42-.098-.57-.241-.152-.143-.196-.366-.231-.572-.065-.378-.125-.756-.192-1.133-.057-.325-.102-.69-.25-.987-.195-.4-.597-.634-.996-.788a5.723 5.723 0 00-.626-.194c-1-.263-2.05-.36-3.077-.416a25.834 25.834 0 00-3.7.062c-.915.083-1.88.184-2.75.5-.318.116-.646.256-.888.501-.297.302-.393.77-.177 1.146.154.267.415.456.692.58.36.162.737.284 1.123.366 1.075.238 2.189.331 3.287.37 1.218.05 2.437.01 3.65-.118.299-.033.598-.073.896-.119.352-.054.578-.513.474-.834-.124-.383-.457-.531-.834-.473-.466.074-.96.108-1.382.146-1.177.08-2.358.082-3.536.006a22.228 22.228 0 01-1.157-.107c-.086-.01-.18-.025-.258-.036-.243-.036-.484-.08-.724-.13-.111-.027-.111-.185 0-.212h.005c.277-.06.557-.108.838-.147h.002c.131-.009.263-.032.394-.048a25.076 25.076 0 013.426-.12c.674.019 1.347.062 2.014.13l.04.005c.11.013.265.033.354.066a.309.309 0 01.186.133c.038.063.067.186.049.3a15.228 15.228 0 01-.148.87c-.026.139-.138.27-.267.29a20.66 20.66 0 01-3.722.23c-1.164-.043-2.318-.188-3.466-.398a8.982 8.982 0 01-.768-.178c-.267-.077-.547-.168-.762-.337-.39-.307-.46-.9-.146-1.272.256-.305.652-.449 1.026-.542a14.147 14.147 0 012.579-.385c1.058-.084 2.124-.07 3.18.005.17.012.345.026.504.051.3.048.6.109.896.183.174.043.356.09.524.162.148.064.354.179.386.36.009.042-.008.125-.042.166-.072.084-.204.12-.315.13-.26.021-.523.021-.786.008a18.178 18.178 0 01-1.953-.181c-.476-.074-.95-.162-1.418-.266-.265-.059-.534-.127-.792-.208-.13-.04-.244-.103-.378-.14-.12-.032-.136.044-.063.113.149.142.38.213.579.272.416.124.843.218 1.275.297.66.122 1.33.207 2.002.258a18.6 18.6 0 002.37-.009c.269-.017.547-.041.736-.2.17-.144.23-.38.195-.59-.056-.325-.188-.625-.35-.907a3.022 3.022 0 00-.4-.527 1.764 1.764 0 00-.385-.321c-.297-.2-.647-.321-1.001-.397a16.488 16.488 0 00-3.052-.357c-1.097-.025-2.2.054-3.282.206-.42.058-.834.131-1.242.228"
                ></path>
                <path
                  d="M4.5 10h15a.5.5 0 01.5.5v.5H4v-.5a.5.5 0 01.5-.5zm.5 2h14l-1.5 8H6.5L5 12z"
                ></path>
              </svg>
            </a>
          </div>
        </div>
        <div
          class="border-surface-200/60 dark:border-surface-800/60 mt-8 border-t pt-6 text-center"
        >
          <p class="text-surface-500 dark:text-surface-500 text-xs">
            &copy; {new Date().getFullYear()} Chomusuke &middot; {
              t('footer.builtWith')
            }
            <a
              href="https://astro.build"
              target="_blank"
              rel="noopener noreferrer"
              class="decoration-brand-400/50 hover:text-brand-500 dark:hover:text-brand-400 underline transition-colors"
              >Astro</a
            >
            {t('footer.and')}
            <a
              href="https://tailwindcss.com"
              target="_blank"
              rel="noopener noreferrer"
              class="decoration-brand-400/50 hover:text-brand-500 dark:hover:text-brand-400 underline transition-colors"
              >Tailwind CSS</a
            >
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
