---
import type { CollectionEntry } from 'astro:content';
import TechBadge from './TechBadge.astro';
import ProjectIcon from './ProjectIcon.astro';
import { useTranslations, type Lang } from '@i18n/utils';

export interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
  lang?: Lang;
}

const { project, index = 0, lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const title =
  lang === 'en' && project.data.title_en
    ? project.data.title_en
    : project.data.title;
const description =
  lang === 'en' && project.data.description_en
    ? project.data.description_en
    : project.data.description;

const { techStack, githubLink, liveLink, downloadLink, featured, bentoSpan } =
  project.data;
---

<article
  class:list={[
    'glass-card-hover group animate-fade-in-up flex flex-col justify-between p-6 opacity-0',
    bentoSpan || 'col-span-1',
    featured &&
      'from-brand-950/20 ring-brand-500/30 dark:ring-brand-400/30 bg-gradient-to-b to-transparent ring-2',
    `stagger-${Math.min(index + 1, 6)}`,
  ]}
>
  <div>
    <!-- Header -->
    <div class="mb-3 flex items-start justify-between gap-3">
      <div class="flex items-center gap-3">
        <!-- Project Icon -->
        <div
          class:list={[
            'flex h-10 w-10 shrink-0 items-center justify-center rounded-xl transition-transform group-hover:scale-110',
            featured
              ? 'from-brand-500 shadow-brand-500/25 bg-gradient-to-br to-purple-600 text-white shadow-md'
              : 'bg-surface-100 text-surface-600 dark:bg-surface-800 dark:text-surface-300',
          ]}
        >
          <ProjectIcon slug={project.id} class="h-5 w-5" />
        </div>
        <div>
          <h3
            class="text-surface-900 text-lg font-bold tracking-tight break-words dark:text-white"
          >
            {title}
          </h3>
          {
            featured && (
              <span class="text-brand-600 dark:text-brand-400 inline-flex items-center gap-1 text-xs font-semibold">
                <svg
                  class="h-3 w-3"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                  aria-hidden="true"
                >
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                {t('projects.card.featured')}
              </span>
            )
          }
        </div>
      </div>
    </div>

    <!-- Description -->
    <p
      class="text-surface-600 dark:text-surface-300 mb-4 line-clamp-3 text-sm leading-relaxed"
    >
      {description}
    </p>

    <!-- Tech Stack -->
    <div class="mb-4 flex flex-wrap gap-1.5">
      {techStack.map((tech: string) => <TechBadge name={tech} />)}
    </div>
  </div>

  <!-- Actions -->
  <div
    class="border-surface-100 dark:border-surface-700/40 flex flex-wrap items-center gap-2 border-t pt-4"
  >
    <a
      href={githubLink}
      target="_blank"
      rel="noopener noreferrer"
      class="border-surface-200 text-surface-700 hover:border-surface-300 hover:bg-surface-50 focus-visible:ring-brand-500 dark:border-surface-700 dark:bg-surface-800 dark:text-surface-300 dark:hover:border-surface-600 dark:hover:bg-surface-700 inline-flex items-center gap-1.5 rounded-lg border bg-white px-3 py-1.5 text-xs font-medium transition-all focus:outline-none focus-visible:ring-2"
      aria-label={`GitHub - ${title}`}
    >
      <svg
        class="h-3.5 w-3.5"
        fill="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          fill-rule="evenodd"
          d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
          clip-rule="evenodd"></path>
      </svg>
      {t('projects.card.code')}
    </a>
    {
      downloadLink && (
        <a
          href={downloadLink}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-brand-600 shadow-brand-500/25 hover:bg-brand-700 focus-visible:ring-brand-500 dark:bg-brand-500 dark:hover:bg-brand-600 inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-medium text-white shadow-sm transition-all hover:shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2"
          aria-label={`${t('projects.card.download')} ${title}`}
        >
          <svg
            class="h-3.5 w-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"
            />
          </svg>
          {t('projects.card.download')}
        </a>
      )
    }
    {
      !downloadLink && liveLink && (
        <a
          href={liveLink}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-brand-600 shadow-brand-500/25 hover:bg-brand-700 focus-visible:ring-brand-500 dark:bg-brand-500 dark:hover:bg-brand-600 inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-medium text-white shadow-sm transition-all hover:shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2"
          aria-label={`${t('projects.card.visit')} ${title}`}
        >
          <svg
            class="h-3.5 w-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
            />
          </svg>
          {t('projects.card.visit')}
        </a>
      )
    }
  </div>
</article>
